<!DOCTYPE html>
<html>

<head>
    <title>URL Shortener</title>
</head>

<body>

    <h1>URL Shortener</h1>

    <form action="/url" method="POST">

        <label>Enter URL:</label>

        <input
            type="text"
            name="redirectURL"
            placeholder="https://google.com"
            required
        >

        <button type="submit">
            Shorten URL
        </button>

    </form>

</body>

</html>